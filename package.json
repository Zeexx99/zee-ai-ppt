{
  "name": "zee-ai-ppt",
  "version": "1.2.0",
  "private": true,
  "description": "Zee AI for PowerPoint — AI Assistant & Agent Task-Pane Add-in for Microsoft PowerPoint",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3300 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/make-manifest.mjs",
    "preview": "vite preview --port 3300 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "make-manifest": "node scripts/make-manifest.mjs",
    "generate-icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.54.0",
    "@fluentui/react-icons": "^2.0.245",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/office-js": "^1.0.389",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
